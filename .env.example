# LLMEval Environment Configuration
# Copy this file to .env and fill in your values

# LiteLLM Configuration
# ======================
# LiteLLM Base URL (required)
LITELLM_BASE_URL=http://localhost:4000

# LiteLLM API Key (required)
LITELLM_API_KEY=your_litellm_api_key_here

# Scheduling
# ==========
# Timezone for cron scheduling (default: America/Chicago for CST)
TZ=America/Chicago

# Cron schedule for automated evaluations (default: 12:00 PM daily)
# Format: minute hour day month weekday
# Examples:
#   0 12 * * *  - Daily at 12:00 PM
#   0 */6 * * * - Every 6 hours
#   0 0 * * 1   - Every Monday at midnight
CRON_SCHEDULE=0 12 * * *

# Evaluation Configuration
# ========================
# Models to evaluate (comma-separated, no spaces)
# Examples:
#   litellm/openrouter/anthropic/claude-sonnet-4
#   litellm/openrouter/openai/gpt-4,litellm/openrouter/anthropic/claude-sonnet-4
EVAL_MODELS=litellm/GLM-4.5-FP8-dev,litellm/GLM-4.5-Air-FP8-dev,litellm/openrouter/openai/gpt-oss-20b,litellm/openrouter/openai/gpt-oss-120b,litellm/openrouter/qwen/qwen3-coder,litellm/openrouter/qwen/qwen3-14b

# Tasks to run (comma-separated paths, no spaces) - OPTIONAL
# If not set, auto-discovers all tasks in tasks/ directory
# Paths are relative to /app/ in the container
# Examples:
#   tasks/task1_file_list
#   tasks/task1_file_list,tasks/task2_fix_python_syntax
# Leave commented out to auto-discover all tasks:
# EVAL_TASKS=tasks/task1_file_list
