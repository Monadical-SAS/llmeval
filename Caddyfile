# Caddyfile for LLMEval static website
# Serves evaluation results with automatic HTTPS via Let's Encrypt

eval.monadical.io {
	# Document root - serves the runs/ directory
	root * /srv/runs

	# Enable gzip compression for better performance
	encode gzip

	# SECURITY: Block access to all workspace/ subdirectories
	# These contain sensitive working files that should not be exposed
	@workspace {
		path */workspace/*
	}
	respond @workspace 403

	# Security headers
	header {
		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"
		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"
		# Enable XSS protection
		X-XSS-Protection "1; mode=block"
	}

	# Caching headers for static assets (CSS, JS)
	# Cache for 1 year since we use version query strings for cache busting
	@static {
		path *.css *.js
	}
	header @static {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Shorter cache for HTML files (1 hour)
	# Allows more frequent updates to be visible
	@html {
		path *.html
	}
	header @html {
		Cache-Control "public, max-age=3600, must-revalidate"
	}

	# Cache for JSON and text files (1 day)
	@data {
		path *.json *.txt
	}
	header @data {
		Cache-Control "public, max-age=86400"
	}

	# Serve files, try index.html for directories
	file_server {
		index index.html
	}

	# Logging
	log {
		output file /var/log/caddy/access.log
		format json
	}
}
